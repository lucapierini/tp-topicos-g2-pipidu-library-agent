# Secretos
GEMINI_API_KEY=

# Modelo (D15)
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
AGENT_TEMPERATURE=0
AGENT_MAX_STEPS=6
AGENT_API_TIMEOUT_S=30

# Semántica temporal (D6, R-3.11)
CUATRIMESTRE_START=2026-08-01
CUATRIMESTRE_END=2026-11-30
TZ=America/Argentina/Buenos_Aires

# RAG (D12, R-4.4, R-4.8)
RAG_TOP_K=5
