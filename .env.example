# Secretos
GEMINI_API_KEY=AQ.Ab8RN6JrLaCbCTIhsNHiXUHf-5AJwWATwQnJ1cfUzCnE5Uk6lA

# Modelo (D15)
GEMINI_MODEL=gemini-3.1-flash-lite
# Proveedor alternativo (LiteLLM). Vacío = Gemini con GEMINI_MODEL. Ejemplo con un servidor local
# OpenAI-compatible: LLM_MODEL=openai/<id-del-modelo>, LLM_API_BASE=http://127.0.0.1:8080/v1, LLM_API_KEY=local
LLM_MODEL=
LLM_API_BASE=
LLM_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
AGENT_TEMPERATURE=0
AGENT_MAX_STEPS=6
AGENT_API_TIMEOUT_S=30
AGENT_API_MAX_RETRIES=3

# Semántica temporal (D6, R-3.11)
CUATRIMESTRE_START=2026-08-01
CUATRIMESTRE_END=2026-11-30
# No usar `TZ`: es una variable del sistema (Cloud Run la fija en UTC). Se aplica a la sesión SQL.
APP_TIMEZONE=America/Argentina/Buenos_Aires

# RAG (D12, R-4.4, R-4.8)
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.67

# Herramienta SQL (R-3.6, D8)
SQL_MAX_ROWS=50
SQL_STATEMENT_TIMEOUT_MS=10000
SQL_MAX_ATTEMPTS=2
SQL_MAX_TABLE_REFS=8

# Base de datos (docker compose up -d la crea con estos roles; ver README)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=pipidu
# `require` al conectar a Neon (TLS obligatorio); vacío para la base local de Docker.
POSTGRES_SSLMODE=
# La aplicación usa dos roles: lectura del dominio y escritura del registro (D63).
POSTGRES_USER=agent_ro
POSTGRES_PASSWORD=
POSTGRES_LOG_USER=agent_logger
POSTGRES_LOG_PASSWORD=
# Solo para inicializar/restaurar la base local de Docker; la aplicación NO lo usa.
POSTGRES_ADMIN_PASSWORD=
# Réplica de la base compartida (scripts/replicate_neon.sh). Es un secreto: solo en .env, nunca en el repo.
NEON_DATABASE_URL=
# Trazabilidad (R-6.2): pg | memory | off
AGENT_RUNS_BACKEND=pg
