# Herramienta SQL (R-3.6, D8)
SQL_MAX_ROWS=50
SQL_STATEMENT_TIMEOUT_MS=10000
SQL_MAX_ATTEMPTS=2

# Base de datos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pipidu
POSTGRES_USER=agent_ro
