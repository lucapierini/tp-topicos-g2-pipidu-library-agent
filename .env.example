# Secretos
GEMINI_API_KEY=

# Modelo (D15)
GEMINI_MODEL=gemini-3-flash-preview
# Proveedor alternativo (LiteLLM). Vacío = Gemini con GEMINI_MODEL. Ejemplo con un servidor local
# OpenAI-compatible: LLM_MODEL=openai/<id-del-modelo>, LLM_API_BASE=http://127.0.0.1:8080/v1, LLM_API_KEY=local
LLM_MODEL=
LLM_API_BASE=
LLM_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
AGENT_TEMPERATURE=0
AGENT_MAX_STEPS=6
AGENT_API_TIMEOUT_S=30
AGENT_API_MAX_RETRIES=3

# Semántica temporal (D6, R-3.11)
CUATRIMESTRE_START=2026-08-01
CUATRIMESTRE_END=2026-11-30
# No usar `TZ`: es una variable del sistema (Cloud Run la fija en UTC). Se aplica a la sesión SQL.
APP_TIMEZONE=America/Argentina/Buenos_Aires

# RAG (D12, R-4.4, R-4.8)
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35

# Herramienta SQL (R-3.6, D8)
SQL_MAX_ROWS=50
SQL_STATEMENT_TIMEOUT_MS=10000
SQL_MAX_ATTEMPTS=2
SQL_MAX_TABLE_REFS=8

# Base de datos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pipidu
POSTGRES_USER=agent_ro
POSTGRES_PASSWORD=
