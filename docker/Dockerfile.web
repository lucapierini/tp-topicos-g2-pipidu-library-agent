# Imagen de la interfaz web (D84, R-8.8). Se construye desde la raíz del repo:
#
#   docker build -f docker/Dockerfile.web -t pipidu-web .
#
# Sirve la SPA de `web/` con nginx y reenvía `/api/` a la API (servicio `api` de docker-compose), de modo
# que el navegador usa un único origen y no hace falta CORS. No lleva secretos (R-8.9): el contexto
# excluye `.env` (`.dockerignore`) y la SPA no recibe variables de entorno en ejecución.

# --- build: compila la SPA a estáticos ---------------------------------------------------------------
FROM node:24-alpine AS build
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

# --- runtime: nginx con los estáticos y el proxy hacia la API ----------------------------------------
FROM nginx:1.29-alpine AS runtime
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=5s --timeout=3s --retries=10 \
  CMD wget -q --spider http://127.0.0.1/ || exit 1
